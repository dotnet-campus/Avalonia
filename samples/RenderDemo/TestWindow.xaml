<Window x:Class="RenderDemo.TestWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ControlSamples"
        xmlns:pages="using:RenderDemo.Pages"
        xmlns:viewModels="using:RenderDemo.ViewModels"
        Background="Transparent"
        Title="AvaloniaUI Rendering Test"
        WindowState="FullScreen">
    <Grid RowDefinitions="*,Auto">
        <Border >
            <Button Content="Hi" />
        </Border>

        <Rectangle Width="200" Height="200" Fill="Red"></Rectangle>

        <StackPanel Grid.Row="1" Orientation="Horizontal" IsVisible="False">
          <Button x:Name="SetTransparencyButton" Click="SetTransparencyButton_OnClick">Transparency</Button>
            <Button x:Name="SetNotTransparencyButton" Click="SetNotTransparencyButton_OnClick">NotTransparency</Button>
        </StackPanel>
    </Grid>

</Window>
